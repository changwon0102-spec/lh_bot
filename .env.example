# Supabase server-side secret (sb_secret_...) or legacy service_role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# First run includes matching announcements published in the last 30 days.
LOOKBACK_DAYS=30
MAX_LIST_PAGES=5
MAX_POSTS_PER_RUN=20
REQUEST_DELAY_SECONDS=1.0
MAX_ATTACHMENT_MB=20
MAX_PDF_PAGES=150
LLM_CHUNK_CHARS=24000
MAX_LLM_CHUNKS=12
